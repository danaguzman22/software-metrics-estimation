# Variables de entorno para docker compose.
# Copiar este archivo a .env para personalizar los valores.
# .env no se versiona y no debe contener credenciales reales.

# Usuario de PostgreSQL.
POSTGRES_USER=postgres

# Clave ficticia, solo para desarrollo local.
POSTGRES_PASSWORD=dev_password

# Nombre de la base de datos.
POSTGRES_DB=metricas

# La aplicación construye DATABASE_URL a partir de estas variables
# apuntando al servicio postgres en el puerto 5432. Es equivalente a:
# DATABASE_URL=postgres://postgres:dev_password@postgres:5432/metricas?sslmode=disable

# HTTP_ADDR no se configura acá: compose.yml lo fija en :8080 dentro del contenedor
# y publica ese mismo puerto en el host.
